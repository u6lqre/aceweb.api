generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  password String
  isAccepted Boolean @default(false)
  channels Channel[]
}

model Channel {
  id Int @id @default(autoincrement())
  name String
  link String
  imageUrl String
  userId Int
  user User @relation(fields: [userId], references: [id])
}
